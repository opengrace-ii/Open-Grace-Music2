# GEMINI_API_KEY: Optional. OGM Studio AI transcript + listen notes.
# App still runs if this is missing (honest empty states).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_API_KEY: Optional fallback for transcript / notes (NVIDIA NIM).
# NVIDIA_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OGM_PUBLIC_BASE_URL: Public HTTPS origin for PWA/APK converter defaults (Render).
OGM_PUBLIC_BASE_URL="https://open-grace-music2.onrender.com"

# Optional: Netscape cookies.txt or Cookie header for youtube.com (Render env).
# Lets the studio converter fetch the exact video when YouTube blocks datacenter IPs.
# OGM_YT_COOKIES=
