# GEMINI_API_KEY: Optional. OGM Studio AI transcript + listen notes.
# App still runs if this is missing (honest empty states).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_API_KEY: Optional fallback for transcript / notes (NVIDIA NIM).
# NVIDIA_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OGM_PUBLIC_BASE_URL: Public HTTPS origin for PWA/APK converter defaults (Render).
OGM_PUBLIC_BASE_URL="https://open-grace-music2.onrender.com"

# Shared secret for recorder workers (never commit the real value).
# Same value on Render and on every worker machine. Phone APK Record does not need this.
# OGM_WORKER_SECRET=

# Optional hub the worker polls (defaults to the public site).
# OGM_HUB_URL=https://open-grace-music2.onrender.com
